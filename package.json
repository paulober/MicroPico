{
  "name": "pico-w-go",
  "displayName": "MicroPico",
  "description": "%extension.description%",
  "version": "4.4.0",
  "publisher": "paulober",
  "license": "Apache-2.0",
  "homepage": "https://micropico.paulober.dev",
  "bugs": {
    "url": "https://github.com/paulober/MicroPico/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulober/MicroPico.git"
  },
  "icon": "images/logo-256.png",
  "galleryBanner": {
    "color": "#5666c6",
    "theme": "dark"
  },
  "markdown": "github",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.137.0",
    "node": ">=24.18"
  },
  "keywords": [
    "micropython",
    "raspberry pi pico",
    "raspberry pi pico w",
    "raspberry pi pico 2",
    "raspberry pi pico 2 w",
    "rp2040",
    "rp2350",
    "esp32",
    "microcontroller",
    "embedded",
    "education",
    "plotter",
    "repl",
    "pico-w-go"
  ],
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "MicroPico does not support as first workspace a virtual one but contributes a virtual workspace for the Pico (W)."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Why would you want to use MicroPico in an untrusted workspace?"
    }
  },
  "extensionDependencies": [
    "ms-python.python"
  ],
  "activationEvents": [
    "workspaceContains:.picowgo",
    "workspaceContains:.micropico",
    "onFileSystem:pico"
  ],
  "main": "./dist/extension.js",
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64",
    "arm"
  ],
  "minimumNodeVersion": 22,
  "contributes": {
    "commands": [
      {
        "command": "micropico.connect",
        "title": "%command.connect.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.disconnect",
        "title": "%command.disconnect.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.initialise",
        "title": "%command.initialise.title%",
        "enablement": "(resourceScheme != pico && isFileSystemResource) || inQuickOpen",
        "category": "MicroPico"
      },
      {
        "command": "micropico.newProject",
        "title": "%command.newProject.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.upload",
        "title": "%command.upload.title%",
        "enablement": "micropico.isConnected && (resourceScheme != pico && isFileSystemResource) || inQuickOpen",
        "category": "MicroPico"
      },
      {
        "command": "micropico.uploadFile",
        "title": "%command.uploadFile.title%",
        "enablement": "micropico.isConnected && resourceScheme != pico && isFileSystemResource",
        "category": "MicroPico"
      },
      {
        "command": "micropico.downloadFile",
        "title": "%command.downloadFile.title%",
        "enablement": "micropico.isConnected && resourceScheme == pico && isFileSystemResource",
        "category": "MicroPico"
      },
      {
        "command": "micropico.download",
        "title": "%command.download.title%",
        "enablement": "(resourceScheme == pico && isFileSystemResource) || inQuickOpen",
        "category": "MicroPico"
      },
      {
        "command": "micropico.run",
        "title": "%command.run.title%",
        "enablement": "micropico.isConnected && resourceScheme != pico && isFileSystemResource && resourceExtname == .py",
        "category": "MicroPico"
      },
      {
        "command": "micropico.remote.run",
        "title": "%command.remote.run.title%",
        "enablement": "resourceScheme == pico && isFileSystemResource && resourceExtname == .py",
        "category": "MicroPico"
      },
      {
        "command": "micropico.universalStop",
        "title": "%command.universalStop.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.runselection",
        "title": "%command.runselection.title%",
        "enablement": "micropico.isConnected && !inQuickOpen && !listFocus && editorLangId == python",
        "category": "MicroPico"
      },
      {
        "command": "micropico.deleteAllFiles",
        "title": "%command.deleteAllFiles.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.globalSettings",
        "title": "%command.globalSettings.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.workspaceSettings",
        "title": "%command.workspaceSettings.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.reset.soft",
        "title": "%command.reset.soft.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.reset.hard",
        "title": "%command.reset.hard.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.reset.hard.listen",
        "title": "%command.reset.hard.listen.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.help",
        "title": "%command.help.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.extra.pins",
        "title": "%command.extra.pins.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.extra.getSerial",
        "title": "%command.extra.getSerial.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.extra.firmwareUpdates",
        "title": "%command.extra.firmwareUpdates.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.extra.switchStubs",
        "title": "%command.extra.switchStubs.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.listCommands",
        "title": "%command.listCommands.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.toggleFileSystem",
        "title": "%command.toggleFileSystem.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.switchPico",
        "title": "%command.switchPico.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.reset.soft.listen",
        "title": "%command.reset.soft.listen.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.rtc.sync",
        "title": "%command.rtc.sync.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.device-wifi.itemClicked",
        "title": "%command.device-wifi.itemClicked.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.device-wifi.refresh",
        "title": "%command.device-wifi.refresh.title%",
        "icon": {
          "dark": "images/refresh-dark.svg",
          "light": "images/refresh-light.svg"
        },
        "enablement": "view == micropico-device-wifi"
      },
      {
        "command": "micropico.garbageCollect",
        "title": "%command.garbageCollect.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.flashPico",
        "title": "%command.flashPico.title%",
        "category": "MicroPico"
      },
      {
        "command": "micropico.redirectOutput",
        "title": "%command.redirectOutput.title%",
        "category": "MicroPico",
        "enablement": "micropico.isConnected"
      },
      {
        "command": "micropico.openPlotter",
        "title": "%command.openPlotter.title%",
        "category": "MicroPico"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "micropico.explorerContext",
          "group": "micropico"
        }
      ],
      "editor/context": [
        {
          "submenu": "micropico.editorContext",
          "group": "micropico"
        }
      ],
      "editor/title": [
        {
          "command": "micropico.run",
          "group": "micropico",
          "when": "micropico.isActivated && resourceScheme != pico && isFileSystemResource && resourceExtname == .py && editorLangId == python"
        },
        {
          "command": "micropico.remote.run",
          "group": "micropico",
          "when": "micropico.isActivated && resourceScheme == pico && isFileSystemResource && resourceExtname == .py && editorLangId == python"
        },
        {
          "command": "micropico.upload",
          "group": "micropico",
          "when": "micropico.isActivated && resourceScheme != pico"
        },
        {
          "command": "micropico.download",
          "group": "micropico",
          "when": "micropico.isActivated && resourceScheme == pico"
        }
      ],
      "view/title": [
        {
          "command": "micropico.device-wifi.refresh",
          "when": "view == micropico-device-wifi",
          "group": "navigation@0"
        }
      ],
      "terminal/context": [
        {
          "command": "micropico.redirectOutput",
          "group": "MicroPico",
          "when": "micropico.isConnected"
        }
      ],
      "micropico.explorerContext": [
        {
          "command": "micropico.upload",
          "group": "2_transfer@3",
          "when": "micropico.isActivated && resourceScheme != pico"
        },
        {
          "command": "micropico.uploadFile",
          "group": "2_transfer@1",
          "when": "micropico.isActivated && resourceScheme != pico"
        },
        {
          "command": "micropico.downloadFile",
          "group": "2_transfer@2",
          "when": "micropico.isActivated && resourceScheme == pico"
        },
        {
          "command": "micropico.download",
          "group": "2_transfer@4",
          "when": "micropico.isActivated && resourceScheme == pico"
        },
        {
          "command": "micropico.run",
          "group": "1_run@1",
          "when": "micropico.isActivated && resourceScheme != pico && isFileSystemResource && resourceExtname == .py"
        },
        {
          "command": "micropico.remote.run",
          "group": "1_run@1",
          "when": "micropico.isActivated && resourceScheme == pico && isFileSystemResource && resourceExtname == .py"
        },
        {
          "command": "micropico.initialise",
          "group": "3_project@1",
          "when": "resourceScheme != pico"
        }
      ],
      "micropico.editorContext": [
        {
          "command": "micropico.run",
          "group": "1_run@1",
          "when": "micropico.isActivated && resourceScheme != pico && isFileSystemResource && resourceExtname == .py && editorLangId == python"
        },
        {
          "command": "micropico.remote.run",
          "group": "1_run@1",
          "when": "micropico.isActivated && resourceScheme == pico && isFileSystemResource && resourceExtname == .py && editorLangId == python"
        },
        {
          "command": "micropico.runselection",
          "group": "1_run@2",
          "when": "micropico.isActivated"
        },
        {
          "command": "micropico.uploadFile",
          "group": "2_transfer@1",
          "when": "micropico.isActivated && resourceScheme != pico && isFileSystemResource"
        }
      ]
    },
    "configuration": {
      "title": "MicroPico",
      "properties": {
        "micropico.autoConnect": {
          "type": "boolean",
          "scope": "machine-overridable",
          "default": true,
          "title": "%config.autoConnect.title%",
          "description": "%config.autoConnect.description%",
          "order": 2
        },
        "micropico.manualComDevice": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "title": "%config.manualComDevice.title%",
          "description": "%config.manualComDevice.description%",
          "order": 3
        },
        "micropico.customVidPidPairs": {
          "type": "array",
          "scope": "machine-overridable",
          "items": {
            "type": "object",
            "properties": {
              "vid": {
                "type": "number",
                "description": "Vendor ID (VID) in decimal (e.g., 1027 for 0x0403)"
              },
              "pid": {
                "type": "number",
                "description": "Product ID (PID) in decimal (e.g., 24592 for 0x6010)"
              }
            },
            "required": [
              "vid",
              "pid"
            ]
          },
          "default": [],
          "title": "%config.customVidPidPairs.title%",
          "markdownDescription": "%config.customVidPidPairs.markdownDescription%",
          "order": 4
        },
        "micropico.syncFolder": {
          "type": "string",
          "scope": "machine-overridable",
          "default": null,
          "title": "%config.syncFolder.title%",
          "description": "%config.syncFolder.description%",
          "order": 5
        },
        "micropico.additionalSyncFolders": {
          "type": "array",
          "scope": "machine-overridable",
          "items": {
            "type": "string",
            "uniqueItems": true
          },
          "default": [],
          "title": "%config.additionalSyncFolders.title%",
          "description": "%config.additionalSyncFolders.description%",
          "order": 6
        },
        "micropico.syncAllFileTypes": {
          "type": "boolean",
          "scope": "machine-overridable",
          "default": false,
          "title": "%config.syncAllFileTypes.title%",
          "description": "%config.syncAllFileTypes.description%",
          "order": 7
        },
        "micropico.syncFileTypes": {
          "type": "array",
          "scope": "machine-overridable",
          "items": {
            "type": "string",
            "uniqueItems": true
          },
          "default": [
            "py",
            "txt",
            "log",
            "json",
            "xml",
            "html",
            "js",
            "css",
            "mpy"
          ],
          "title": "%config.syncFileTypes.title%",
          "description": "%config.syncFileTypes.description%",
          "order": 8
        },
        "micropico.pyIgnore": {
          "title": "%config.pyIgnore.title%",
          "scope": "machine-overridable",
          "markdownDescription": "%config.pyIgnore.markdownDescription%",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.picowgo",
            "**/.micropico",
            "**/.vscode",
            "**/.gitignore",
            "**/.git",
            "**/.DS_Store",
            "**/project.pico-go",
            "**/env",
            "**/venv",
            "**/.venv",
            "**/.idea"
          ],
          "order": 9
        },
        "micropico.openOnStart": {
          "type": "boolean",
          "default": false,
          "scope": "machine-overridable",
          "title": "%config.openOnStart.title%",
          "description": "%config.openOnStart.description%",
          "order": 10
        },
        "micropico.statusbarButtons": {
          "type": "array",
          "scope": "machine-overridable",
          "title": "%config.statusbarButtons.title%",
          "description": "%config.statusbarButtons.description%",
          "items": {
            "type": "string",
            "uniqueItems": true,
            "enum": [
              "status",
              "stop",
              "run",
              "runselection",
              "upload",
              "download",
              "disconnect",
              "softreset",
              "settings",
              "listserial",
              "listcommands",
              "togglepicowfs",
              "uploadproject",
              "downloadproject"
            ]
          },
          "default": [
            "status",
            "run",
            "softreset",
            "togglepicowfs"
          ],
          "order": 11
        },
        "micropico.gcBeforeUpload": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "title": "%config.gcBeforeUpload.title%",
          "description": "%config.gcBeforeUpload.description%",
          "order": 12
        },
        "micropico.softResetAfterUpload": {
          "type": "boolean",
          "scope": "machine-overridable",
          "default": false,
          "title": "%config.softResetAfterUpload.title%",
          "description": "%config.softResetAfterUpload.description%",
          "order": 13
        },
        "micropico.executeOnConnect": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "title": "%config.executeOnConnect.title%",
          "description": "%config.executeOnConnect.description%",
          "order": 14
        },
        "micropico.importOnConnect": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "title": "%config.importOnConnect.title%",
          "description": "%config.importOnConnect.description%",
          "order": 15
        },
        "micropico.noSoftResetOnRun": {
          "type": "boolean",
          "scope": "machine-overridable",
          "default": false,
          "title": "%config.noSoftResetOnRun.title%",
          "description": "%config.noSoftResetOnRun.description%",
          "order": 16
        },
        "micropico.disableRunFileTypeWarning": {
          "type": "boolean",
          "scope": "machine-overridable",
          "default": false,
          "title": "%config.disableRunFileTypeWarning.title%",
          "description": "%config.disableRunFileTypeWarning.description%",
          "order": 17
        },
        "micropico.alwaysStopRunningProgram": {
          "type": "boolean",
          "scope": "machine-overridable",
          "default": false,
          "title": "%config.alwaysStopRunningProgram.title%",
          "description": "%config.alwaysStopRunningProgram.description%",
          "order": 18
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "title": "MicroPico vREPL",
          "id": "micropico.vrepl"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "micropico-device-controller",
          "title": "%viewContainer.micropico-device-controller.title%",
          "icon": "images/logo-black.png"
        }
      ],
      "panel": [
        {
          "id": "micropico-plotter-panel",
          "title": "%viewContainer.micropico-plotter-panel.title%",
          "icon": "images/logo-black.png"
        }
      ]
    },
    "views": {
      "micropico-device-controller": [
        {
          "id": "micropico-device-wifi",
          "name": "%view.micropico-device-wifi.name%",
          "type": "tree"
        },
        {
          "id": "micropico-device-packages",
          "name": "%view.micropico-device-packages.name%",
          "type": "webview"
        }
      ],
      "micropico-plotter-panel": [
        {
          "id": "micropico-plotter",
          "name": "%view.micropico-plotter.name%",
          "type": "webview",
          "when": "micropico.isActivated"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "%viewsWelcome.createProject%",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "submenus": [
      {
        "id": "micropico.explorerContext",
        "label": "MicroPico"
      },
      {
        "id": "micropico.editorContext",
        "label": "MicroPico"
      }
    ]
  },
  "scripts": {
    "vscode:uninstall": "node ./dist/vscodeUninstall.mjs",
    "vscode:prepublish": "npm run package",
    "postinstall": "patch-package && node ./scripts/postinstall.mjs",
    "cp-prebuilds": "node -e \"const fs=require('fs');fs.rmSync('prebuilds',{recursive:true,force:true});fs.cpSync('node_modules/@serialport/bindings-cpp/prebuilds','prebuilds',{recursive:true});\"",
    "compile": "tsc --build tsconfig.json --noEmit false",
    "watch": "npm run cp-prebuilds && webpack --watch --mode development",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "package-local": "npm run clean && webpack --mode production && npm run cp-prebuilds",
    "package": "npm run clean && webpack --mode production",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "l10n:export": "node ./scripts/l10n.mjs export",
    "l10n:check": "node ./scripts/l10n.mjs check",
    "pretest": "node -e \"require('fs').rmSync('test-out',{recursive:true,force:true})\"",
    "test": "npm run compile-tests && node --import ./test/register.mjs --test \"test-out/**/*.test.mjs\"",
    "test:e2e": "npm run package-local && node ./test/e2e/runE2E.mjs",
    "verify:vsix": "node ./scripts/check-vsix.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@serialport/bindings-cpp": "^13.0.1",
    "@types/eslint": "^9.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.6",
    "@types/vscode": "^1.137.0",
    "@types/which": "^3.0.4",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "patch-package": "^8.0.1",
    "ts-loader": "^9.6.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "uplot": "^1.6.32",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@paulober/pico-mpy-com": "^1.0.28",
    "@vscode/python-extension": "^1.0.6",
    "axios": "^1.13.6",
    "fs-extra": "^11.4.0",
    "lodash": "^4.17.23",
    "undici": "^8.10.2",
    "uuid": "^13.0.0",
    "which": "^5.0.0"
  },
  "packageManager": "npm@11.11.0+sha512.f36811c4aae1fde639527368ae44c571d050006a608d67a191f195a801a52637a312d259186254aa3a3799b05335b7390539cf28656d18f0591a1125ba35f973",
  "allowScripts": {
    "@serialport/bindings-cpp": false
  },
  "qna": "https://github.com/paulober/MicroPico/discussions/categories/q-a"
}
