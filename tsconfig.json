{
  "compilerOptions": {
    "module": "node16",
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "sourceMap": true,
    "inlineSourceMap": false,
    "noEmit": true,
    "removeComments": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "rootDir": "src",
    "outDir": "out",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "esModuleInterop": true
  },
  "exclude": [
    "node_modules",
    "pico-mpy-com"
  ]
}
